DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,asset-system.local
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://asset-system.local
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_SECURE_COOKIES=False
DJANGO_LOG_LEVEL=INFO
QR_PAGE_PUBLIC=False
SQLITE_DATABASE_PATH=/app/data/db.sqlite3
DJANGO_MEDIA_ROOT=/app/data/media
DJANGO_SERVE_MEDIA=True

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.local
DJANGO_SUPERUSER_PASSWORD=replace-admin-password
RESET_ADMIN_PASSWORD=False
AUTO_BOOTSTRAP=True
LOAD_DEMO_DATA=True
